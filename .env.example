# Viola Frontend - Environment Variables
# Copy this file to .env and fill in your values.
# Do not commit .env to version control.

# API Base URL (default: /api - proxied to backend in dev)
# VITE_API_BASE_URL=/api

# Cloud Run URLs - optional; Search uses backend proxy (MUSIC_SEARCH)
# Set these only if frontend calls Chatbot/CLAP APIs directly
# VITE_CHATBOT_API_URL=https://your-chatbot-url.run.app/chat
# VITE_CLAP_API_URL=https://your-clap-url.run.app/query

# ChromaDB (optional - for direct ChromaDB access from frontend)
# VITE_CHROMA_API_KEY=your-chroma-api-key
# VITE_CHROMA_TENANT=your-tenant-id
# VITE_CHROMA_DATABASE=VIOLA
# VITE_CHROMA_COLLECTION_NAME=fma_small

# MongoDB (optional - prefer backend API; never expose credentials in frontend)
# VITE_MONGODB_URL=
